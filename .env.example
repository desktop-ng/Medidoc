# App
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/femhealth

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use long random strings (minimum 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CRYPTO_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Email (Gmail / SMTP fallback)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/auth/github/callback
